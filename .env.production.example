APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=5003
CORS_ORIGINS=https://your-frontend.example.com
CMS_BASE_URL=https://your-cms.example.com
PORTAL_BASE_URL=https://your-portal.example.com
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-secret
AI_SERVICE_AUTH_SECRET=replace-with-a-separate-service-secret
OPENAI_API_KEY=replace-with-openai-secret
OPENAI_MINI_MODEL=gpt-5-mini-2025-08-07
OPENAI_NANO_MODEL=gpt-5-nano-2025-08-07
OPENAI_TIMEOUT_MS=30000
SOURCE_DATABASE_URL=postgresql://readonly_user:password@postgres:5432/main_db
AI_DATABASE_URL=postgresql://ai_user:password@postgres:5432/ai_db
AI_PERSISTENCE_MODE=postgres
SOURCE_DB_POOL_MAX=5
AI_DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_SSL=false
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=egi.egiholding@gmail.com
EMAIL_SMTP_APP_PASSWORD=inject-through-secret-manager
EMAIL_FROM_ADDRESS=egi.egiholding@gmail.com
EMAIL_FROM_NAME=EGI Media
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=1000
LOG_LEVEL=info
SERVICE_NAME=egi-media-ai-backend
METRICS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000

AI_SCHEDULER_ENABLED=false
AI_SCHEDULER_INTERVAL_MS=900000
AI_SCHEDULER_LOCALES=id
AI_INGEST_BATCH_SIZE=50
AI_INGEST_TIMEOUT_MS=30000
AI_INGEST_MAX_ATTEMPTS=3
AI_INGEST_WORKER_CONCURRENCY=1
AI_PIPELINE_WORKER_CONCURRENCY=1
AI_SCHEDULER_CATCH_UP=true
AI_SYSTEM_TENANT_ID=system
AI_SYSTEM_COMPANY_ID=source-ingest
AI_PIPELINE_COMPANIES=
AI_BOOTSTRAP_COMPANY_CONTEXT=false
AI_AUTOMATION_RECIPIENT_ID=
AI_MAX_REQUESTS_PER_WINDOW=0
AI_MAX_TOKENS_PER_WINDOW=0
AI_BUDGET_WINDOW_MS=3600000
AI_BUDGET_ENFORCED=true
