APP_HOST=localhost
APP_ENV=development
APP_PORT=5003
CORS_ORIGINS=http://localhost:3000

CMS_BASE_URL=http://localhost:5002
CMS_TIMEOUT_MS=10000
PORTAL_BASE_URL=http://localhost:3000

# S03 auth context. Use the same access-token verification secret as the main backend,
# or set AUTH_ACCESS_TOKEN_SECRET explicitly. Do not trust tenant/company headers as identity.
AUTH_ACCESS_TOKEN_SECRET=

OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-5-mini-2025-08-07
OPENAI_NANO_MODEL=gpt-5-nano-2025-08-07
OPENAI_TIMEOUT_MS=30000
# Manual S24 integration-test guard. These are request/token ceilings, not dollar estimates.
OPENAI_INTEGRATION_MAX_REQUESTS=4
OPENAI_INTEGRATION_MAX_TOKENS=8000

# Source of truth: egi-media-backend database. This connection must use a read-only role.
SOURCE_DATABASE_URL=postgresql://egi_media_source:password@localhost:5432/egi_media_main
# AI-owned database. AI migrations and AI domain tables are applied here.
AI_DATABASE_URL=postgresql://egi_media_ai:password@localhost:5432/egi_media_ai
AI_TEST_DATABASE_URL=postgresql://egi_media_ai_test:password@localhost:5432/egi_media_ai_test
SOURCE_DB_POOL_MAX=5
AI_DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_SSL=false
REDIS_URL=redis://localhost:6379

# Email delivery (Gmail SMTP with an App Password)
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EGI Media
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=1000
# S25 is manual and requires an explicit recipient; never enable this in CI by default.
EMAIL_TEST_RECIPIENT=

LOG_LEVEL=info
SERVICE_NAME=egi-media-ai-backend
METRICS_ENABLED=false
SHUTDOWN_TIMEOUT_MS=10000
