APP_HOST=localhost
APP_ENV=development
APP_PORT=5003
CORS_ORIGINS=http://localhost:3000

CMS_BASE_URL=http://localhost:5002
CMS_TIMEOUT_MS=10000
PORTAL_BASE_URL=http://localhost:3000

# S03 auth context. Use the same access-token verification secret as the main backend,
# or set AUTH_ACCESS_TOKEN_SECRET explicitly. Do not trust tenant/company headers as identity.
AUTH_ACCESS_TOKEN_SECRET=
BOOTSTRAP_ADMIN_EMAIL=egi.egiholding@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
# Bootstrap is platform-only; it is never a customer tenant/company identity.
AI_SERVICE_AUTH_SECRET=

OPENAI_API_KEY=
# One model for all T0x tasks. Keep MINI/NANO equal (aliases still used in code).
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MINI_MODEL=gpt-5.6-luna
OPENAI_NANO_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000
OPENAI_T01_TIMEOUT_MS=120000
# Shared OpenAI guard across all T0x tasks. Keep concurrency conservative;
# set RPM/TPM only when the provider quota is known. 0 means no fixed local ceiling.
OPENAI_MAX_CONCURRENCY=2
OPENAI_RATE_LIMIT_RPM=0
OPENAI_RATE_LIMIT_TPM=0
OPENAI_RATE_LIMIT_SAFETY_RATIO=0.8
OPENAI_OUTPUT_TOKEN_RESERVE=1000
# T02: consensus; only high/medium continue to issue formation.
# T02_INCLUDE_BODY_SNIPPET=false
# T02_USE_RUBRIC=true
# T02_DUAL_CALL=true
# T02_CONSENSUS_CALLS=3
# Manual S24 integration-test guard. These are request/token ceilings, not dollar estimates.
OPENAI_INTEGRATION_MAX_REQUESTS=4
OPENAI_INTEGRATION_MAX_TOKENS=8000

# Source of truth: egi-media-backend database. This connection must use a read-only role.
SOURCE_DATABASE_URL=postgresql://egi_media_source:password@localhost:5432/egi_media_main
# AI-owned database. AI migrations and AI domain tables are applied here.
AI_DATABASE_URL=postgresql://egi_media_ai:password@localhost:5432/egi_media_ai
# Crawl-owned article database. This connection must use a read-only role.
CRAWL_DATABASE_URL=postgresql://egi_media_crawl_reader:password@localhost:5432/egi_media_crawl
AI_PERSISTENCE_MODE=memory
# Memory is development-only. Use postgres for persistent multi-tenant environments.
AI_TEST_DATABASE_URL=postgresql://egi_media_ai_test:password@localhost:5432/egi_media_ai_test
# Optional test-only placeholder auth. Keep false/unset for real local signup/login.
AI_LOCAL_PREVIEW_AUTH=false
SOURCE_DB_POOL_MAX=5
AI_DB_POOL_MAX=10
CRAWL_DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
CRAWL_DB_CONNECTION_TIMEOUT_MS=3000
CRAWL_DB_QUERY_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=10000
DB_SSL=false
REDIS_URL=redis://localhost:6379

# Email delivery (Gmail SMTP with an App Password)
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EGI Media
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=1000
# S25 is manual and requires an explicit recipient; never enable this in CI by default.
EMAIL_TEST_RECIPIENT=

LOG_LEVEL=info
SERVICE_NAME=egi-media-ai-backend
METRICS_ENABLED=false
SHUTDOWN_TIMEOUT_MS=10000

# Automation / News intake
# Automatic intake (CMS poll scheduler) — safe default: off
AI_SCHEDULER_ENABLED=false
# Queue workers (ingest + pipeline). Default on so manual "Pull articles now"
# still runs when the scheduler is off. Set false only to pause processing.
AI_WORKERS_ENABLED=true
# Production requires an explicit allowlist when workers are on.
# Example for ACME demo only: AI_WORKER_TENANT_IDS=acme-holding-demo
AI_WORKER_TENANT_IDS=
AI_ALLOW_EVAL_TENANTS=false
AI_SCHEDULER_INTERVAL_MS=900000
AI_SCHEDULER_LOCALES=id
AI_INGEST_BATCH_SIZE=50
AI_INGEST_TIMEOUT_MS=30000
AI_INGEST_MAX_ATTEMPTS=3
AI_INGEST_WORKER_CONCURRENCY=1
AI_PIPELINE_WORKER_CONCURRENCY=1
# Prevent reclaiming live AI requests as stale; keep above the longest T0x timeout.
AI_WORKER_STALE_TIMEOUT_MS=900000
# Parsed today but unused by scheduler/workers (dead config until a catch-up sprint)
AI_SCHEDULER_CATCH_UP=true
AI_SYSTEM_TENANT_ID=system
AI_SYSTEM_COMPANY_ID=source-ingest
AI_PIPELINE_COMPANIES=
AI_BOOTSTRAP_COMPANY_CONTEXT=false
AI_AUTOMATION_RECIPIENT_ID=
AI_MAX_REQUESTS_PER_WINDOW=200
AI_MAX_TOKENS_PER_WINDOW=200000
AI_BUDGET_WINDOW_MS=3600000
AI_BUDGET_ENFORCED=false
