APP_HOST=localhost
APP_ENV=development
APP_PORT=5003
CORS_ORIGINS=http://localhost:3000

CMS_BASE_URL=http://localhost:5002
CMS_TIMEOUT_MS=10000
PORTAL_BASE_URL=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-5-mini-2025-08-07
OPENAI_NANO_MODEL=gpt-5-nano-2025-08-07
OPENAI_TIMEOUT_MS=30000

POSTGRESQL_URL=postgresql://postgres:postgres@localhost:5432/egi_media
REDIS_URL=redis://localhost:6379

# Email delivery (Gmail SMTP with an App Password)
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EGI Media
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=1000
